REACT_APP_SERVICE_MANAGEMENT_URL=https://bevprogateway.southeastasia.cloudapp.azure.com/svc
REACT_APP_API_BASE_URL=http://localhost:44496/api/v1
# ผ่าน Kong gateway (/prod catch-all -> service.bevproasia.com/api/v1 เส้นเดิม) — ได้ log/แยกรายแอปด้วย X-App-Name
REACT_APP_API_PROD_BASE_URL=https://bevprogateway.southeastasia.cloudapp.azure.com/prod/api/v1
