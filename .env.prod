# Copy this to .env and adjust values for your environment
# ผ่าน Kong gateway — /prod = catch-all ไปเครื่อง service.bevproasia.com (prod-service คือ IP เดียวกัน)
REACT_APP_API_BASE_URL=https://bevprogateway.southeastasia.cloudapp.azure.com/prod/api/v1
REACT_APP_API_PROD_BASE_URL=https://bevprogateway.southeastasia.cloudapp.azure.com/prod/api/v1
# NAS ภายใน — gateway เข้าไม่ถึง คงตรงไว้
REACT_APP_API_ONELAKE_URL=https://bevproasia-nas:4005/api